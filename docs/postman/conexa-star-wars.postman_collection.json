    {
      "name": "02 - Authentication",
      "description": "Run registration only when the account does not exist. Login must succeed before catalog folders. Credentials are JSON-escaped by the folder pre-request script.",
      "item": [
        {
          "name": "Register account (first use only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "201 creates the account. A documented 409 is accepted on reruns; it does not prove the supplied account exists. Login must still succeed.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{authBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registration is created or a documented conflict\", function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) pm.test(\"Registration returns username without a token\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.username).to.equal(pm.environment.get(\"username\"));",
                  "    pm.expect(body).not.to.have.property(\"password\");",
                  "    pm.expect(body).not.to.have.property(\"accessToken\");",
                  "});",
                  "if (pm.response.code === 409) pm.test(\"Conflict has a known registration code\", function () {",
                  "    pm.expect([\"AUTH_USERNAME_EXISTS\", \"AUTH_REGISTRATION_IP_USED\"]).to.include(pm.response.json().code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login and save accessToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Stores the issued token only in the selected environment. Clears any previous token before validating the response.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{authBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"accessToken\");",
                  "pm.test(\"Login succeeds\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Login returns a Bearer token for 900 seconds\", function () {",
                  "        pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.tokenType).to.equal(\"Bearer\");",
                  "        pm.expect(body.expiresIn).to.equal(900);",
                  "        pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
                  "    });",
                  "    if (typeof body.accessToken === \"string\" && body.accessToken && body.tokenType === \"Bearer\") {",
                  "        pm.environment.set(\"accessToken\", body.accessToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const username = pm.environment.get(\"username\");",
              "const password = pm.environment.get(\"password\");",
              "if (!username || !password) throw new Error(\"Select a supplied environment and set your own username and password before running Authentication.\");",
              "pm.variables.set(\"authBody\", JSON.stringify({ username: username, password: password }));"
            ]
          }
        }
      ]
    },
