{
  "info": {
    "_postman_id": "6cbf390b-ef46-420e-88f9-85bc9abc1220",
    "name": "Conexa Star Wars API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Public endpoints, registration/login, paginated catalog queries, filters, and negative cases. Import the local or Heroku environment and set your own credentials. Login stores accessToken in the selected environment; catalog requests inherit Bearer authentication. All exported credentials/tokens are empty. Read docs/postman/README.md before running. One successful registration per direct connection address and instance; accounts reset on restart. Provider data can change. This collection does not load-test the app or automatically exhaust quotas."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "page",
      "value": "1",
      "type": "string"
    },
    {
      "key": "size",
      "value": "2",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const url = pm.variables.replaceIn(pm.request.url.toString());",
          "if (pm.response.code === 200 && /\\/api\\/v1\\/(people|films|starships|vehicles)(?:\\?|$)/.test(url)) {",
          "    const body = pm.response.json();",
          "    pm.test(\"Catalog page has the public contract\", function () {",
          "        pm.expect(body.items).to.be.an(\"array\");",
          "        [\"page\", \"size\", \"totalItems\", \"totalPages\"].forEach(function (field) {",
          "            pm.expect(body[field]).to.be.a(\"number\");",
          "            pm.expect(Number.isInteger(body[field])).to.equal(true);",
          "        });",
          "        pm.expect(body.page).to.be.at.least(1);",
          "        pm.expect(body.size).to.be.within(1, 10);",
          "        pm.expect(body.items.length).to.be.at.most(body.size);",
          "        pm.expect(body.totalItems).to.be.at.least(body.items.length);",
          "        pm.expect(body.totalPages).to.be.at.least(0);",
          "        body.items.forEach(function (item) {",
          "            pm.expect(item.id).to.match(/^[1-9][0-9]*$/);",
          "            pm.expect(item.name).to.be.a(\"string\").and.not.empty;",
          "        });",
          "    });",
          "}"
        ]
      }
    }
  ],
