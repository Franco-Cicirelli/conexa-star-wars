    {
      "name": "07 - Validation and security",
      "description": "The 400 cases require a valid token; otherwise Spring Security correctly returns 401 first. These requests do not automatically exhaust quotas or simulate provider failures.",
      "item": [
        {
          "name": "Catalog without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/people",
            "description": "Explicitly disables inherited collection authentication. An empty 401 body is valid.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Catalog with invalid token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/people",
            "description": "Uses a deliberately invalid dummy token without modifying the environment's valid accessToken.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid.jwt.token",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
